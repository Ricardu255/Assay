<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Assay Checkstyle configuration: deliberately small and stable.
  Only rules that catch real maintenance hazards (unused/star imports,
  tabs, missing newline, overly long lines) are enabled so the gate stays
  actionable; formatting is not enforced beyond that.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>
  <property name="charset" value="UTF-8"/>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^(package|import) .*$"/>
  </module>

  <module name="NewlineAtEndOfFile"/>

  <module name="SuppressWarningsFilter"/>

  <module name="TreeWalker">
    <module name="SuppressWarningsHolder"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="AvoidStarImport"/>
    <module name="CustomImportOrder">
      <property name="customImportOrderRules"
                value="STATIC###THIRD_PARTY_PACKAGE###STANDARD_JAVA_PACKAGE"/>
      <property name="sortImportsInGroupAlphabetically" value="true"/>
      <property name="separateLineBetweenGroups" value="false"/>
    </module>
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MemberName"/>
    <module name="MethodName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="NPathComplexity">
      <property name="max" value="1000000"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="30"/>
    </module>
  </module>
</module>
